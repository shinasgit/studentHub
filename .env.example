# Firebase Configuration (Frontend & Backend)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=studenthub-36f7a
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloud Backend API (Set to your Render URL for production frontend builds)
# Example: https://ai-studenthub-backend.onrender.com
# Leave blank in local development to automatically use Vite dev middleware
VITE_API_BASE_URL=https://ai-studenthub-backend.onrender.com

# Backend Server Environment Variables (Configured on Render)
PORT=10000
NODE_ENV=production
FIREBASE_PROJECT_ID=studenthub-36f7a
ALLOWED_ORIGINS=https://studenthub-36f7a.web.app,https://studenthub-36f7a.firebaseapp.com
ENABLE_LOCAL_AI_PROXIES=false

